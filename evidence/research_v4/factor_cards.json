    "expected_direction": "unvalidated",
    "source": "offline_formula_catalogue"
  },
  {
    "id": "dsl_volume_surprise",
    "label": "相对成交量",
    "expression": "safe_divide(volume, rolling_mean(volume, 20)) - 1",
    "hypothesis": "相对成交量可能反映关注度变化，方向需要验证。",
    "expected_direction": "unvalidated",
    "source": "offline_formula_catalogue"
  },
  {
    "id": "dsl_volume_trend",
    "label": "成交量趋势",
    "expression": "safe_divide(rolling_mean(volume, 5), rolling_mean(volume, 20)) - 1",
    "hypothesis": "持续放量可能与价格趋势状态相关。",
    "expected_direction": "unvalidated",
    "source": "offline_formula_catalogue"
  },
  {
    "id": "dsl_bar_pressure_5",
    "label": "5日实体压力",
    "expression": "rolling_mean(safe_divide(close - open, high - low), 5)",
