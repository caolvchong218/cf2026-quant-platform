    "expected_direction": "unvalidated",
    "source": "offline_formula_catalogue"
  },
  {
    "id": "dsl_close_position_10",
    "label": "10日收盘区间位置",
    "expression": "rolling_mean(safe_divide(close - low, high - low), 10)",
    "hypothesis": "收盘靠近日内高点的状态可能持续。",
    "expected_direction": "unvalidated",
    "source": "offline_formula_catalogue"
  },
  {
    "id": "dsl_price_volume_corr",
    "label": "20日价量相关",
    "expression": "rolling_corr(returns(close), returns(volume), 20)",
    "hypothesis": "收益与成交量变化的关系可能刻画趋势可靠性。",
    "expected_direction": "unvalidated",
    "source": "offline_formula_catalogue"
  },
  {
    "id": "dsl_trend_volume",
    "label": "趋势与成交量组合",
    "expression": "rank(returns(close, 20)) * rank(safe_divide(volume, rolling_mean(volume, 20)))",
    "hypothesis": "趋势和成交量同时较强可能提供不同于单因子的信号。",
    "expected_direction": "unvalidated",
    "source": "offline_formula_catalogue"
  },
  {
    "id": "dsl_risk_adjusted_trend",
    "label": "波动调整趋势",
    "expression": "safe_divide(returns(close, 20), rolling_std(returns(close), 20))",
    "hypothesis": "同等波动下的趋势强度可能具有比较价值。",
    "expected_direction": "unvalidated",
    "source": "offline_formula_catalogue"
  },
  {
    "id": "dsl_distance_high_20",
    "label": "距20日高点",
    "expression": "safe_divide(close, rolling_max(high, 20)) - 1",
    "hypothesis": "接近历史高点的价格可能具有趋势或阻力信息。",
    "expected_direction": "unvalidated",
    "source": "offline_formula_catalogue"
  },
  {
    "id": "dsl_distance_low_20",
    "label": "距20日低点",
    "expression": "safe_divide(close, rolling_min(low, 20)) - 1",
    "hypothesis": "脱离历史低点的幅度可能刻画恢复状态。",
    "expected_direction": "unvalidated",
    "source": "offline_formula_catalogue"
  }
